# Use .env.local for local secrets. Never commit real credentials.
DATABASE_URL=
PATHWAY_SESSION_SECRET=
GOOGLE_CLIENT_ID=
OPENROUTER_API_KEY=
PATHWAY_PUBLIC_URL=http://localhost:8080
PATHWAY_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Campus recommendations reuse the existing Transfer Planner OpenRouter key.
# Set provider=bedrock to use the original AWS integration instead.
CAMPUS_COMPASS_AI_PROVIDER=auto
CAMPUS_COMPASS_AI_MODEL=

# Choose one mail transport. SMTP uses implicit TLS (default port 465).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Transfer Pathway
CAMPUS_COMPASS_EMAIL=
CAMPUS_COMPASS_EMAIL_PASSWORD=
CAMPUS_COMPASS_SMTP_HOST=smtp.gmail.com
CAMPUS_COMPASS_SMTP_PORT=465

# Only opted-in accounts receive emails. The server must remain running.
PATHWAY_DAILY_EMAILS_ENABLED=true
DAILY_EMAIL_TIME=09:00
DAILY_EMAIL_TIMEZONE=America/Los_Angeles
## De Anza Chatbot: its separate RAG database with the pgvector `chunks` table.
## Required in production; local development can read ../DeAnza_Chatbot/.env.
DEANZA_CHAT_DATABASE_URL=
DEANZA_CHAT_MODEL=google/gemini-2.5-flash,openai/gpt-4o-mini,mistralai/mistral-small-24b-instruct-2501
DEANZA_CHAT_CONDENSER_MODEL=google/gemini-2.5-flash-lite
